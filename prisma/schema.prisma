generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model User {
  id                     String           @id @default(cuid())
  name                   String?
  email                  String           @unique
  emailVerified          DateTime?
  image                  String?
  plan                   Plan             @default(FREE)
  stripeCustomerId       String?          @unique
  stripeSubscriptionId   String?          @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?
  resumesCreated         Int              @default(0)
  totalResumesCreated    Int              @default(0)
  monthlyResumesCreated  Int              @default(0)
  resumeCountResetAt     DateTime         @default(now())
  monthlyTailors         Int              @default(0)
  tailorsResetAt         DateTime         @default(now())
  monthlyCoverLetters    Int              @default(0)
  coverLettersResetAt    DateTime         @default(now())
  lastActiveAt           DateTime         @default(now())
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  accounts               Account[]
  feedback               Feedback[]
  applications           JobApplication[]
  resumes                Resume[]
  sessions               Session[]
  entitlements           Entitlement[]
  events                 Event[]

  @@map("users")
}

model Resume {
  id                    String           @id @default(cuid())
  userId                String
  title                 String
  originalContent       Json?
  currentContent        Json
  contactInfo           Json?
  professionalSummary   Json?
  workExperience        Json?
  education             Json?
  skills                Json?
  projects              Json?
  additionalSections    Json?
  structuredDataVersion String?          @default("1.0")
  dataCompletionScore   Float?
  lastStructuredUpdate  DateTime?
  originalFileUrl       String?
  templateId            String?
  s3Key                 String?
  s3Bucket              String?
  originalFileName      String?
  fileSize              Int?
  thumbnailUrl          String?
  contentType           String?
  isActive              Boolean          @default(true) // false = deleted (soft)
  // Set when a newer upload replaced this master. Hidden masters stay usable and show
  // up in Manage resumes, just not in the Resume card's switcher.
  hiddenAt              DateTime?
  // "2" = the structured parser (src/lib/parse-resume.ts). Null on rows from the old
  // extractor, which get a "re-upload" banner.
  parserVersion         String?
  // Evidence interview answers (src/lib/evidence.ts): { answers: EvidenceAnswer[] }.
  // Kept so later tailoring can use them.
  evidence              Json?
  wordCount             Int?
  lastOptimized         DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  applications          JobApplication[]
  versions              ResumeVersion[]
  user                  User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model ResumeVersion {
  id                String   @id @default(cuid())
  resumeId          String
  versionNumber     Int
  content           Json
  changes           String?
  structuredContent Json?
  createdAt         DateTime @default(now())
  resume            Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  @@unique([resumeId, versionNumber])
  @@map("resume_versions")
}

model JobApplication {
  id                   String            @id @default(cuid())
  userId               String
  resumeId             String
  jobTitle             String
  company              String
  jobDescription       String
  jobUrl               String?
  originalContent      Json?
  optimizedContent     Json?
  optimizedStructured  Json?
  matchScore           Float?
  categoryScores       Json?
  keywords             String[]
  suggestions          Json?
  analysisVersion      String?           @default("1.0")
  lastAnalyzed         DateTime?
  status               ApplicationStatus @default(DRAFT)
  appliedAt            DateTime?
  responseAt           DateTime?
  generatedPdfUrl      String?
  // Cover letter (src/lib/cover-letter.ts), edited inline and autosaved.
  coverLetter          Json?
  coverLetterUpdatedAt DateTime?
  // Tracker
  notes                String?
  followUpAt           DateTime?
  statusUpdatedAt      DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  resume               Resume            @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("job_applications")
}

model Feedback {
  id        String       @id @default(cuid())
  userId    String
  type      FeedbackType
  message   String
  email     String?
  pageUrl   String
  userAgent String?
  resolved  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedback")
}

// One row per grant of Pro. getAccess() in src/lib/entitlements.ts is the only
// reader; User.plan is a cached mirror of it for the admin page.
model Entitlement {
  id                String            @id @default(cuid())
  userId            String
  source            EntitlementSource
  status            EntitlementStatus
  startsAt          DateTime          @default(now())
  endsAt            DateTime?
  cancelAtPeriodEnd Boolean           @default(false)
  pastDueAt         DateTime?
  externalId        String?
  stripePriceId     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([userId])
  @@index([status, endsAt])
  @@map("entitlements")
}

// Product analytics (src/lib/track.ts). userId is set null when the user deletes their
// account, so funnel counts survive without pointing at anyone. props never holds
// resume text or contact details: timings, counts, outcomes, token usage.
model Event {
  id        String   @id @default(cuid())
  userId    String?
  name      String
  props     Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId, name, createdAt])
  @@map("events")
}

// Processed Stripe webhook events, for idempotency.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_events")
}

enum EntitlementSource {
  STRIPE_SUBSCRIPTION
  STRIPE_PASS
  COMP
  TOKEN_HOLD // reserved: future crypto path, unused
  TOKEN_PAYMENT // reserved: future crypto path, unused
}

enum EntitlementStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
  REFUNDED
}

enum Plan {
  FREE
  PREMIUM
}

enum ApplicationStatus {
  DRAFT
  OPTIMIZED
  APPLIED
  INTERVIEW
  REJECTED
  OFFER
}

enum FeedbackType {
  BUG_REPORT
  FEATURE_REQUEST
  GENERAL_FEEDBACK
}
